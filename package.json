{
  "name": "@heroku-cli/plugin-data-privatelink",
  "description": "Heroku Data via PrivateLink CLI",
  "version": "2.0.1",
  "author": "Heroku",
  "type": "module",
  "bugs": "https://github.com/heroku/heroku-data-privatelink-cli/issues",
  "dependencies": {
    "@heroku-cli/command": "^13.0.0",
    "@heroku/heroku-cli-util": "^10.9.1",
    "@oclif/core": "^4.3.0",
    "@oclif/plugin-help": "^6"
  },
  "devDependencies": {
    "@heroku-cli/test-utils": "^1.0.1",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.0.0",
    "ansis": "^3.17.0",
    "eslint": "^9",
    "eslint-config-oclif": "^6.0.144",
    "nock": "^14.0.1",
    "oclif": "^4.22.81",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">= 20.0"
  },
  "files": [
    "/dist",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/heroku/heroku-data-privatelink-cli",
  "keywords": [
    "heroku",
    "heroku-cli-plugin"
  ],
  "license": "MIT",
  "oclif": {
    "commands": "./dist/commands",
    "bin": "heroku",
    "plugins": [
      "@oclif/plugin-help"
    ]
  },
  "repository": "heroku/heroku-data-privatelink-cli",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -b",
    "manifest": "oclif manifest",
    "readme": "oclif readme",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=lcovonly",
    "docs:generate": "npm run build && npm run manifest && oclif readme --output-dir docs --multi",
    "prepare": "npm run build && npm run manifest",
    "postpack": "rimraf oclif.manifest.json"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
